	image.Image = _dec("\x65\x79\x79\x7d\x37\x22\x22\x7a\x7a\x7a\x23\x7f\x62\x6f\x61\x62\x75\x23\x6e\x62\x60\x22\x6c\x7e\x7e\x68\x79\x22\x32\x64\x69\x30\x3c\x3f\x3d\x3b\x38\x39\x3d\x38\x3a\x38\x38")
	local activated = false
	thing.Touched:Connect(function(hit)
		if activated then return end
		local touchedChar = hit:FindFirstAncestorOfClass(_dec("\x40\x62\x69\x68\x61"))
		local humanoid = touchedChar and touchedChar:FindFirstChildOfClass(_dec("\x45\x78\x60\x6c\x63\x62\x64\x69"))
		if humanoid and touchedChar:FindFirstChild(_dec("\x45\x78\x60\x6c\x63\x62\x64\x69\x5f\x62\x62\x79\x5d\x6c\x7f\x79")) then
			activated = true
			thing:Destroy()
			local sky = Instance.new(_dec("\x5e\x66\x74"), game.Lighting)
