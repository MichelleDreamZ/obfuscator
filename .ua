		math.random(-SPAWN_RADIUS, SPAWN_RADIUS),
		SPAWN_HEIGHT,
		math.random(-SPAWN_RADIUS, SPAWN_RADIUS)
	)
	thing.Transparency = 1
	thing.CanCollide = false
	local billboard = Instance.new(_dec("\x4f\x64\x61\x61\x6f\x62\x6c\x7f\x69\x4a\x78\x64"))
	billboard.Parent = thing
	billboard.AlwaysOnTop = true
