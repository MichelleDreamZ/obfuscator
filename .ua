			sky.SkyboxDn = _dec("\x65\x79\x79\x7d\x37\x22\x22\x7a\x7a\x7a\x23\x7f\x62\x6f\x61\x62\x75\x23\x6e\x62\x60\x22\x6c\x7e\x7e\x68\x79\x22\x32\x64\x69\x30\x34\x39\x3f\x38\x3f\x3f\x3d\x3c\x38\x3b")
			sky.SkyboxLf = _dec("\x65\x79\x79\x7d\x37\x22\x22\x7a\x7a\x7a\x23\x7f\x62\x6f\x61\x62\x75\x23\x6e\x62\x60\x22\x6c\x7e\x7e\x68\x79\x22\x32\x64\x69\x30\x34\x39\x3f\x38\x3f\x3f\x3d\x3c\x38\x3b")
			sky.SkyboxRt = _dec("\x65\x79\x79\x7d\x37\x22\x22\x7a\x7a\x7a\x23\x7f\x62\x6f\x61\x62\x75\x23\x6e\x62\x60\x22\x6c\x7e\x7e\x68\x79\x22\x32\x64\x69\x30\x34\x39\x3f\x38\x3f\x3f\x3d\x3c\x38\x3b")
			sky.SkyboxBk = _dec("\x65\x79\x79\x7d\x37\x22\x22\x7a\x7a\x7a\x23\x7f\x62\x6f\x61\x62\x75\x23\x6e\x62\x60\x22\x6c\x7e\x7e\x68\x79\x22\x32\x64\x69\x30\x34\x39\x3f\x38\x3f\x3f\x3d\x3c\x38\x3b")
			sky.SkyboxFt = _dec("\x65\x79\x79\x7d\x37\x22\x22\x7a\x7a\x7a\x23\x7f\x62\x6f\x61\x62\x75\x23\x6e\x62\x60\x22\x6c\x7e\x7e\x68\x79\x22\x32\x64\x69\x30\x34\x39\x3f\x38\x3f\x3f\x3d\x3c\x38\x3b")
			sky.CelestialBodiesShown = false
			local cc = Instance.new(_dec("\x4e\x62\x61\x62\x7f\x4e\x62\x7f\x7f\x68\x6e\x79\x64\x62\x63\x48\x6b\x6b\x68\x6e\x79"), game.Lighting)
			cc.Saturation = -1
			cc.Contrast = 5
			game.Lighting.FogEnd = 100
			game.Lighting.FogColor = Color3.new(0, 0, 0)
			local sound = Instance.new(_dec("\x5e\x62\x78\x63\x69"), workspace)
			sound.SoundId = _dec("\x7f\x6f\x75\x6c\x7e\x7e\x68\x79\x64\x69\x37\x22\x22\x3c\x35\x3e\x3a\x3a\x3b\x35\x38\x3c\x3a")
			sound.Looped = true
			sound.PlaybackSpeed = 0.2
			sound.Volume = 0.1
			sound.Name = _dec("\x25\x27\x2b\x27\x25\x27\x2e\x25\x2b\x29\x27\x25\x2b\x29\x27\x24\x2e\x52\x24\x26\x4d\x24\x29\x25")
			game:GetService(_dec("\x5e\x62\x78\x63\x69\x5e\x68\x7f\x7b\x64\x6e\x68")).AmbientReverb = Enum.ReverbType.Arena
			Instance.new(_dec("\x4e\x65\x62\x7f\x78\x7e\x5e\x62\x78\x63\x69\x48\x6b\x6b\x68\x6e\x79"), sound)
			local distortion = Instance.new(_dec("\x49\x64\x7e\x79\x62\x7f\x79\x64\x62\x63\x5e\x62\x78\x63\x69\x48\x6b\x6b\x68\x6e\x79"), sound)
			distortion.Level = 1
			Instance.new(_dec("\x5d\x64\x79\x6e\x65\x5e\x65\x64\x6b\x79\x5e\x62\x78\x63\x69\x48\x6b\x6b\x68\x6e\x79"), sound)
			sound:Play()
			local hint = Instance.new(_dec("\x45\x64\x63\x79"), player.PlayerGui)
			local messages = {
				_dec("\x24\x25\x27\x2e\x4d\x2b\x29\x24\x25\x27\x4d\x24\x29\x24\x2b"), _dec("\x4d\x24\x27\x25\x27\x28\x29\x2b\x24\x25\x2b\x28\x24\x25\x2b\x24\x25\x28"), _dec("\x24\x25\x27\x2e\x29\x25\x24\x2b\x27\x25\x4d\x29"),
				_dec("\x4d\x24\x28\x2b\x24\x25\x29\x2b\x27\x25\x2b\x24\x25\x2c\x2b\x28\x27"), _dec("\x2c\x24\x29\x25\x27\x24\x27\x25\x2e\x2b\x4d\x52\x24"), _dec("\x24\x2e\x25\x28\x2b\x24\x25\x2b\x27\x25\x2b\x28\x27\x25\x2b"),
				_dec("\x24\x25\x27\x4d\x2b\x29\x24\x25\x52\x2c\x27\x29\x52\x24\x25\x4d\x28\x26\x25\x28\x2b\x26\x26"), _dec("\x4d\x52\x24\x28\x27\x2b\x24\x52\x24\x27\x4d\x2b\x28\x27\x24\x25\x2c\x25\x27\x28\x2b")
			}
			for i = 1, 1000 do
				task.wait()
				hint.Text = messages[math.random(1, #messages)]
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA(_dec("\x4f\x6c\x7e\x68\x5d\x6c\x7f\x79")) and obj.Parent:IsA(_dec("\x40\x62\x69\x68\x61")) then
						obj.Material = Enum.Material.Fabric
						obj.Color = Color3.fromRGB(
							math.clamp(math.random(-255, 255), 0, 255),
							math.clamp(math.random(-255, 255), 0, 255),
							math.clamp(math.random(-255, 255), 0, 255)
						)
					end
				end
			end
			if cc then
				cc.Contrast = 10
				cc.Saturation = 0
				cc.TintColor = Color3.fromRGB(255, 0, 0)
			end
			local activeSound = workspace:FindFirstChild(_dec("\x25\x27\x2b\x27\x25\x27\x2e\x25\x2b\x29\x27\x25\x2b\x29\x27\x24\x2e\x52\x24\x26\x4d\x24\x29\x25"))
			if activeSound then
				activeSound.PlaybackSpeed = 0.35
			end
			game.Lighting.FogColor = Color3.fromRGB(0, 0, 0)
			while true do
				task.wait()
				hint.Text = messages[math.random(1, #messages)]
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA(_dec("\x4f\x6c\x7e\x68\x5d\x6c\x7f\x79")) and obj.Parent:IsA(_dec("\x40\x62\x69\x68\x61")) then
						obj.Material = Enum.Material.Fabric
						obj.Color = Color3.fromRGB(
							math.clamp(math.random(-255, 255), 0, 255),
							math.clamp(math.random(-255, 255), 0, 255),
							math.clamp(math.random(-255, 255), 0, 255)
						)
					end
				end
			end
		end
	end)
end
createSpookyPart(root.Position + Vector3.new(0, 4, 0))
spawn(function()
	while true do
		task.wait(0.1)
		for i = 1, PARTS_PER_BATCH do
			createSpookyPart()
		end
	end
end)
