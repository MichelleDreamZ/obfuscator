--[[
    Protegido por Vangeliicide Obfuscator
]]--
local function _dec(s)
    local r = ""
    for i = 1, #s do
        local b = string.byte(s, i)
        r = r .. string.char(b ~ 13)
    end
    return r
end

local Players = game:GetService(_dec("\x5d\x61\x6c\x74\x68\x7f\x7e"))
local player = Players.LocalPlayer
local PARTS_PER_BATCH = 10
local SPAWN_RADIUS = 200
local SPAWN_HEIGHT = 4
local character = player.Character or player.CharacterAdded:Wait()
